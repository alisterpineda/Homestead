{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Processing": {
    "MaxConcurrency": 4
  },
  "Ocr": {
    "Engines": {
      "tesseract": {
        "Type": "Tesseract",
        "TessDataPath": "tessdata",
        "Languages": [ "Eng" ],
        "Dpi": 300,
        "Psm": 3,
        "Oem": 3
      }
    }
  }
}
