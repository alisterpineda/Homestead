bin/
bin\*
obj/
obj\*
/packages/
riderModule.iml
.idea/
/_ReSharper.Caches/
**/dataSources.xml

# Frontend
node_modules/
# pnpm resolves its package store to the repo root here (`pnpm store path` -> /.pnpm-store);
# a transitive dev toolchain populates it during installs. Never ours to track.
/.pnpm-store/
Homestead.WebApi/wwwroot/

# Tesseract models are provisioned by scripts/fetch-tessdata.sh (pinned in tessdata.ref),
# never committed. The manifest + ref + script are tracked; the downloaded models are not.
**/*.traineddata

# Python (skill scripts + tooling)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-anon/

.local/

# Local dev document storage (provisioned by the Aspire AppHost; see AppHost.cs)
.homestead-data/

# Claude Code
.claude/settings.local.json
.claude/skills/*-workspace/
.claude/scheduled_tasks.lock

# document-anonymizer: optional Azure image-edit config (endpoint/key) — never commit
.claude/skills/document-anonymizer/.env

# playwright-cli output — snapshots, screenshots, saved login state (Claude Code self-QA)
.playwright-cli/

# AI eval harness: disk cache (under-test + judge responses), results store, and generated report
**/.eval-reports/
**/report.html