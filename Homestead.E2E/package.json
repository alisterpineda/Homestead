{
  "name": "homestead-e2e",
  "private": true,
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "infra:build": "docker build -t homestead:e2e -f ../Dockerfile ..",
    "infra:up": "npm run infra:build && docker compose -f docker-compose.e2e.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.e2e.yml down -v"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
